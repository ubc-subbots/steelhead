<root BTCPP_format="4" main_tree_to_execute="OctagonOnlyMission">
  <BehaviorTree ID="OctagonOnlyMission">
    <Sequence name="octagon_mission">
      <Timeout msec="120000">
        <Octagon name="surface_octagon"
                 label="helmet"
                 center_offset_x="0.0"
                 center_offset_y="0.0"
                 surface_alignment_threshold="0.3"
                 surface_duration="10.0"/>
      </Timeout>
      <DriveFor name="post_octagon_hold"
                force_x="0.0"
                duration="2.0"/>
    </Sequence>
  </BehaviorTree>
</root>
