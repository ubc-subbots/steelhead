<root BTCPP_format="4" main_tree_to_execute="TorpedoOnlyMission">
  <BehaviorTree ID="TorpedoOnlyMission">
    <Sequence name="torpedo_mission">
      <Timeout msec="120000">
        <Torpedo name="fire_torpedoes"
                 label="circle"
                 center_offset="0.0"
                 fire_alignment_threshold="0.1"/>
      </Timeout>
      <DriveFor name="post_torpedo_hold"
                force_x="0.0"
                duration="2.0"/>
    </Sequence>
  </BehaviorTree>
</root>
