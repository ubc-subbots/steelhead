  <gazebo reference="camera_link">
    <sensor type="rgbd_camera" name="front_camera">
      <update_rate>60</update_rate>
      <visualize>true</visualize>
      <topic>/front_camera</topic>
      <frame_id>camera_link</frame_id>
      <camera name="front">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="bottom_camera_link">
    <sensor type="camera" name="bottom_camera">
      <update_rate>60</update_rate>
      <visualize>true</visualize>
      <topic>/bottom_camera/image</topic>
      <frame_id>bottom_camera_link</frame_id>
      <camera name="bottom">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
