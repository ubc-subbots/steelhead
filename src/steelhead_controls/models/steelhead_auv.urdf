    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/base_link/odometry</odom_topic>
      <dimensions>3</dimensions>
    </plugin>

    <plugin
      filename="libpressure_sensor.so"
      name="steelhead_gazebo::PressureSensor">
      <publish_topic>/steelhead/drivers/pressure_sensor</publish_topic>
      <update_rate>50</update_rate>
    </plugin>

    <plugin
      name="steelhead_gazebo::ThrusterDriver"
      filename="libthruster_driver_plugin.so">
      <thruster_count>6</thruster_count>
      <ros>
        <namespace>/steelhead/controls</namespace>
        <remapping>output_forces</remapping>
      </ros>
    </plugin>
  </gazebo>
