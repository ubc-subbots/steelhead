<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <shadows>0</shadows>
    </scene>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-buoyancy-system"
      name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.125</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    
    <physics name="1ms" type="dart">
      <max_step_size>0.02</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://competition_slalom</uri>
      <pose>5.3448 1.2131 -1.25 0 0 0</pose>
    </include>

    <include>
      <uri>model://competition_gate</uri>
      <pose>3.44451 -0.19134 0.25 0 0 3.13999</pose>
    </include>

    <include>
      <uri>model://steelhead_auv</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://woollett_pool</uri>
      <pose>10.0564 1.481011 -2.25 0 0 0</pose>
    </include>

    <include>
      <uri>model://competition_cleanup</uri>
      <pose>16.4801 1.715959 -1.320358 0 0 -1.50365</pose>
    </include>

    <include>
      <uri>model://competition_dropper</uri>
      <pose>12.7869 -1.3222 -2.0 0 0 2.10738</pose>
    </include>

    <include>
      <uri>model://competition_octagon</uri>
      <pose>15.1911 1.614284 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://competition_path</uri>
      <pose>4.82476 0.26978 -1.709673 0 0 -1.27847</pose>
    </include>

    <include>
      <name>competition_pathmarker_2</name>
      <uri>model://competition_path</uri>
      <pose>11.6845 0.513518 -1.709673 0 0 -2.54361</pose>
    </include>

    <include>
      <uri>model://competition_tagging</uri>
      <pose>14.9023 -0.62346 -1.13067 0 0 1.69616</pose>
    </include>
  </world>
</sdf>