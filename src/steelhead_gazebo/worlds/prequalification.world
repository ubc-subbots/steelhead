<?xml version="1.0"?>
<sdf version="1.8">
  <world name="prequalication">
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <physics name="fast_simulation" type="ode">
      <max_step_size>0.001</max_step_size> <!-- Larger step size for faster simulation -->
      <real_time_update_rate>1.0</real_time_update_rate> <!-- 0 = as fast as possible, 100 = norma, 200= 2 times speed -->
    </physics>

    <include>
        <pose>3 -1 -0.25 0 0 0</pose>
        <uri>model://prequalification_gate</uri>
    </include>

    <include>
        <pose>10 0 -1.25 0 0 0</pose>
        <uri>model://prequalification_marker</uri>
    </include>

    <include>
      <uri>model://steelhead_auv</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
        <pose>5 0 -2.25 0 0 0</pose>
        <uri>model://woollett_pool</uri>
    </include>

    <grid>0</grid>
  </world>
</sdf>